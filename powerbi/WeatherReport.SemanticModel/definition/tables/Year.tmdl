table Year
	lineageTag: 17d62c4c-7999-4214-a172-87e77b4cbe86
	dataCategory: Time

	column year
		dataType: int64
		isKey
		lineageTag: 857cf348-6bc5-4064-8e9a-5445a645b850
		summarizeBy: none
		sourceColumn: year

	column expected_days
		dataType: int64
		lineageTag: e61846ce-dc54-46d6-9adf-919dc7ce77d4
		summarizeBy: none
		sourceColumn: expected_days

	column is_leap_year
		dataType: boolean
		lineageTag: ac5cb7cb-758d-4919-9ced-5676f45b4846
		summarizeBy: none
		sourceColumn: is_leap_year

	column is_complete_year
		dataType: boolean
		lineageTag: 58474790-d2e0-43ff-b031-15cc02f1a5bf
		summarizeBy: none
		sourceColumn: is_complete_year

	column 'Time Range' =
			VAR YearValue = Year[year]
			VAR EndYear =
			    MAXX(
			        FILTER(ALL(Year), Year[is_complete_year] = TRUE()),
			        Year[year]
			    )
			VAR StartYear = MINX(ALL(Year), Year[year])
			VAR BucketEnd = EndYear - INT((EndYear - YearValue) / 10) * 10
			VAR BucketStart = BucketEnd - 9
			RETURN
			    IF(
			        YearValue < StartYear || YearValue > EndYear,
			        BLANK(),
			        FORMAT(BucketStart, "0") & "-" & FORMAT(BucketEnd, "0")
			    )
		dataType: string
		lineageTag: e3058d42-1984-43e9-a77f-e01c86f7f5b3
		summarizeBy: none

	partition Year = m
		mode: import
		source =
				let
				    Server = DatabaseServer & ":" & Text.From(DatabasePort),
				    Source = Value.NativeQuery(PostgreSQL.Database(Server, DatabaseName, [CreateNavigationProperties=false]), "SELECT year, expected_days, is_leap_year, is_complete_year FROM layer_gold.dim_year", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
